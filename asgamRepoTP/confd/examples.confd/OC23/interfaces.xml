<config xmlns:xc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <interfaces xmlns="http://openconfig.net/yang/interfaces">
    <interface>
	<name>eth0</name>
	<config>
	  <name>eth0</name>	
	  <enabled>true</enabled>
          <!--type xmlns="urn:ietf:params:xml:ns:yang:iana-if-type">ethernetCsmacd</type-->
	</config>
	<ipv4 xmlns="http://openconfig.net/yang/interfaces/ip">
  	     <addresses>
  	      <address>
	        <ip>192.168.1.1</ip>
	        <config>
	          <ip>192.168.1.1</ip>
	          <prefix-length>24</prefix-length>
	        </config>
  	      </address>
  	     </addresses>
	</ipv4>
    </interface>
  </interfaces>
</config>
