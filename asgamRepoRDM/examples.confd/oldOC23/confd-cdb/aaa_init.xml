<config xmlns="http://tail-f.com/ns/config/1.0">

  <aaa xmlns="http://tail-f.com/ns/aaa/1.1">
    <authentication>
      <users>
        <user>
          <name>admin</name>
          <uid>9000</uid>
          <gid>100</gid>
          <password>$0$admin</password>
          <ssh_keydir>/var/confd/homes/admin/.ssh</ssh_keydir>
          <homedir>/var/confd/homes/admin</homedir>
        </user>
        <user>
          <name>optical</name>
          <!--uid>9000</uid>
          <gid>100</gid-->
          <uid>9001</uid>
          <gid>101</gid>
          <password>$0$optical</password>
          <ssh_keydir>/var/confd/homes/optical/.ssh</ssh_keydir>
          <homedir>/var/confd/homes/optical</homedir>
        </user>
        <user>
          <name>packet</name>
          <!--uid>9000</uid>
          <gid>100</gid-->
          <uid>9002</uid>
          <gid>102</gid>
          <password>$0$packet</password>
          <ssh_keydir>/var/confd/homes/packet/.ssh</ssh_keydir>
          <homedir>/var/confd/homes/packet</homedir>
        </user>
        <user>
          <name>oper</name>
          <!--uid>9000</uid>
          <gid>100</gid-->
          <uid>9003</uid>
          <gid>103</gid>
          <password>$0$oper</password>
          <ssh_keydir>/var/confd/homes/oper/.ssh</ssh_keydir>
          <homedir>/var/confd/homes/oper</homedir>
        </user>
        <user>
          <name>public</name>
          <!--uid>9000</uid>
          <gid>100</gid-->
          <uid>9004</uid>
          <gid>100</gid>
          <password>$0$public</password>
          <ssh_keydir>/var/confd/homes/public/.ssh</ssh_keydir>
          <homedir>/var/confd/homes/public</homedir>
        </user>
        <user>
          <name>private</name>
          <!--uid>9000</uid>
          <gid>100</gid-->
          <uid>9005</uid>
          <gid>103</gid>
          <password>$0$private</password>
          <ssh_keydir>/var/confd/homes/private/.ssh</ssh_keydir>
          <homedir>/var/confd/homes/private</homedir>
        </user>
      </users>
    </authentication>
    <ios>
      <level>
        <nr>0</nr>
        <prompt>\h> </prompt>
      </level>
      <level>
        <nr>15</nr>
        <prompt>\h# </prompt>
      </level>
      <privilege>
        <mode>exec</mode>
        <level>
          <nr>0</nr>
          <command>
            <name>exit</name>
          </command>
          <command>
            <name>action</name>
          </command>
          <command>
            <name>help</name>
          </command>
          <command>
            <name>autowizard</name>
          </command>
          <command>
            <name>enable</name>
          </command>
          <command>
            <name>startup</name>
          </command>
        </level>
        <level>
          <nr>15</nr>
          <command>
            <name>configure</name>
          </command>
        </level>
      </privilege>
    </ios>
  </aaa>

  <nacm xmlns="urn:ietf:params:xml:ns:yang:ietf-netconf-acm">
    <enable-nacm>true</enable-nacm>
    <write-default>permit</write-default>
    <read-default>permit</read-default>
    <exec-default>permit</exec-default>
    <enable-external-groups>true</enable-external-groups>
    <!--cmd-read-default>permit</cmd-read-default>
    <cmd-exec-default>permit</cmd-exec-default-->
    <groups>
      <group>
        <name>admin</name>
        <user-name>admin</user-name>
        <user-name>private</user-name>
      </group>
      <group>
        <name>oper</name>
        <user-name>oper</user-name>
        <user-name>public</user-name>
      </group>
      <group>
        <name>opt</name>
        <user-name>optical</user-name>
      </group>
      <group>
        <name>pck</name>
        <user-name>packet</user-name>
      </group>
    </groups>
    <rule-list>
      <name>any-group</name>
      <group>*</group>
      <rule>
        <name>get</name>
        <module-name>*</module-name>
        <path>/</path>
        <access-operations>read</access-operations>
        <!--rpc-name>get-config</rpc-name-->
        <action>permit</action>
      </rule>
    </rule-list>
    <rule-list>
      <name>packet</name>
      <group>pck</group>
      <rule>
        <name>vlan</name>
        <module-name>vlan</module-name>
        <!--path xmlns:v="http://sssup.it/yang/vlan">/v:switched-vlans</path-->
        <path>/switched-vlans</path>
        <access-operations>read create update delete</access-operations>
        <!--rpc-name>edit-config</rpc-name-->
        <action>permit</action>
      </rule>
      <rule>
        <name>terminal-device</name>
        <module-name>*</module-name>
        <!--path xmlns:v=§"http://openconfig.net/yang/terminal-device">/v:terminal-device</path-->
        <path>/terminal-device</path>
        <access-operations>create update delete</access-operations>
        <!--rpc-name>edit-config</rpc-name-->
        <action>deny</action>
      </rule>
      <rule>
        <name>components</name>
        <module-name>*</module-name>
        <!--path xmlns:v="http://openconfig.net/yang/platform">/v:components</path-->
        <path>/components</path>
        <access-operations>create update delete</access-operations>
        <!--rpc-name>edit-config</rpc-name-->
        <action>deny</action>
      </rule>
    </rule-list>
    <rule-list>
      <name>optical</name>
      <group>opt</group>
      <rule>
        <name>terminal-device</name>
        <module-name>*</module-name>
        <!--path xmlns:v=§"http://openconfig.net/yang/terminal-device">/v:terminal-device</path-->
        <path>/terminal-device</path>
        <access-operations>read create update delete</access-operations>
        <!--rpc-name>edit-config</rpc-name-->
        <action>permit</action>
      </rule>
      <rule>
        <name>components</name>
        <module-name>*</module-name>
        <!--path xmlns:v="http://openconfig.net/yang/platform">/v:components</path-->
        <path>/components</path>
        <access-operations>read create update delete</access-operations>
        <!--rpc-name>edit-config</rpc-name-->
        <action>permit</action>
      </rule>
      <rule>
        <name>vlan</name>
        <module-name>vlan</module-name>
        <!--path xmlns:v="http://sssup.it/yang/vlan">/v:switched-vlans</path-->
        <path>/switched-vlans</path>
        <access-operations>create update delete</access-operations>
        <!--rpc-name>edit-config</rpc-name-->
        <action>deny</action>
      </rule>
      <!--rule>
        <name>allow-read-oc-components</name>
        <module-name>openconfig-terminal-device</module-name>
        <path>/components</path>
        <access-operations>read</access-operations>
        <action>permit</action>
      </rule>
      <rule>
        <name>allow-write-vlans</name>
        <module-name>vlan</module-name>
        <path>/switched-vlans</path>
        <access-operations>*</access-operations>
        <action>permit</action>
      </rule>
      <rule>
        <name>deny-write-oc-terminal-device</name>
        <module-name>openconfig-terminal-device</module-name>
        <path>/openconfig-terminal-device</path>
        <access-operations>create update delete</access-operations>
        <action>deny</action>
      </rule>
      <rule>
        <name>deny-write-oc-components</name>
        <module-name>openconfig-terminal-device</module-name>
        <path>/components</path>
        <access-operations>create update delete</access-operations>
        <action>deny</action>
      </rule-->
    </rule-list>
    <rule-list>
      <name>admin</name>
      <group>admin</group>
      <rule>
        <name>any-access</name>
        <action>permit</action>
      </rule>
    </rule-list>
    <rule-list>
      <name>any-group</name>
      <group>*</group>
      <rule>
        <name>tailf-aaa-authentication</name>
        <module-name>tailf-aaa</module-name>
        <path>/aaa/authentication/users/user[name='$USER']</path>
        <access-operations>read update</access-operations>
        <action>permit</action>
      </rule>
      <rule>
        <name>tailf-aaa-user</name>
        <module-name>tailf-aaa</module-name>
        <path>/user[name='$USER']</path>
        <access-operations>create read update delete</access-operations>
        <action>permit</action>
      </rule>
      <rule>
        <name>tailf-webui-user</name>
        <module-name>tailf-webui</module-name>
        <path>/webui/data-stores/user-profile[username='$USER']</path>
        <access-operations>create read update delete</access-operations>
        <action>permit</action>
      </rule>
    </rule-list>
  </nacm>

</config>
